# -----------------------------------------------------------------------
# Stabledesk Pay-per-Query — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# -----------------------------------------------------------------------

# --- Testnet (default) ---
VITE_CONTRACT_ADDRESS=0xd4271deb42a7ee4465b50e1616a3f14a331e3c87
VITE_ARC_TESTNET_CHAIN_ID=5042002
DEPLOY_BLOCK=69168253

# --- Backend ---
STABLEDESK_API_KEY=
BACKEND_PORT=3001

# RPC: set RPC_URL when running outside Arc Studio (Railway, Docker, local).
# Arc Studio injects RPC_PROXY_* automatically; RPC_URL takes priority when set.
# RPC_URL=https://rpc.testnet.arc.io        # testnet
# RPC_URL=https://rpc.mainnet.arc.io        # mainnet (set NETWORK=mainnet too)

# Fallback RPC for testnet (used inside Arc Studio when proxy is unavailable)
FALLBACK_RPC_URL=https://rpc.testnet.arc.io

# --- SQLite database ---
# DB_PATH: path to the SQLite file.
#   - Required in mainnet mode (must be on a persistent volume).
#   - Testnet default: ./data/queries.db
# DB_PATH=/data/queries.db

# --- Mainnet mode ---
# Set BOTH NETWORK=mainnet (backend) AND VITE_NETWORK=mainnet (frontend).
# Frontend build fails if VITE_MAINNET_* vars are missing.
# Backend exits at startup if MAINNET_* vars or DB_PATH are missing.
#
# NETWORK=mainnet
# VITE_NETWORK=mainnet
#
# MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# MAINNET_CHAIN_ID=<arc mainnet chain id>
# MAINNET_CONTRACT_ADDRESS=<deployed QueryPayments address on Arc Mainnet>
# MAINNET_TREASURY=<treasury wallet address>
#
# VITE_MAINNET_CHAIN_ID=<arc mainnet chain id>
# VITE_MAINNET_CONTRACT_ADDRESS=<deployed QueryPayments address on Arc Mainnet>
#
# DB_PATH=/data/queries.db   ← persistent volume mount required on Railway
